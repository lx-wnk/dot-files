{
  "env": {
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "16384",
    "BASH_DEFAULT_TIMEOUT_MS": "30000"
  },
  "permissions": {
    "allow": [
      "mcp__jetbrains__find_files_by_name_keyword",
      "mcp__jetbrains__list_directory_tree",
      "WebSearch",
      "WebFetch(domain:developer.shopware.com)",
      "WebFetch(domain:developers.google.com)",
      "WebFetch(domain:docs.sentry.io)",
      "WebFetch(domain:github.com)",
      "Bash(docker exec:*)",
      "Bash(find:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(ls:*)"
    ],
    "defaultMode": "plan"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Executing command...'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "git add {{file}}"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "code-review@claude-code-plugins": false,
    "security-guidance@claude-code-plugins": false,
    "frontend-design@claude-code-plugins": false,
    "pr-review-toolkit@claude-code-plugins": false,
    "frontend-design@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "shopware-phpunit@FriendsOfShopware-agent-skills": true,
    "github@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "explanatory-output-style@claude-plugins-official": true,
    "learning-output-style@claude-plugins-official": true,
    "php-lsp@claude-plugins-official": true,
    "coderabbit@claude-plugins-official": true,
    "learning-output-style@claude-code-plugins": false
  },
  "outputStyle": "Learning",
  "alwaysThinkingEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "permission": {
    "defaultMode": "plan",
    "disableBypassPermissions": false,
    "allow": [
      "Read(~/code/)",
      "WebSearch",
      "mcp__jetbrains__find_files_by_name_keyword",
      "WebFetch(domain:developers.google.com)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./config/credentials.json)",
      "Read(./build)"
    ]
  }
}
