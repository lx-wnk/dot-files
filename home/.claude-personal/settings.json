{
  "env": {
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "128000",
    "BASH_DEFAULT_TIMEOUT_MS": "30000"
  },
  "permissions": {
    "allow": [
      "mcp__jetbrains__find_files_by_name_keyword",
      "mcp__jetbrains__list_directory_tree",
      "mcp__claude-in-chrome__tabs_context_mcp",
      "WebSearch",
      "WebFetch(domain:developer.shopware.com)",
      "Bash(pnpm typecheck:*)",
      "Bash(npx nuxi typecheck:*)",
      "Bash(make jest:*)",
      "WebFetch(domain:developers.google.com)",
      "WebFetch(domain:docs.sentry.io)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:api.github.com)",
      "Bash(docker exec:*)",
      "Bash(find:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(ls:*)",
      "Bash(curl:*)",
      "Bash(tar:*)",
      "Bash(mktemp:*)",
      "Bash(cp:*)",
      "Read(~/code/)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./config/credentials.json)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null); if [ \"$BRANCH\" = 'main' ] || [ \"$BRANCH\" = 'master' ]; then echo '{\"decision\": \"block\", \"reason\": \"Cannot edit files on main branch. Create a feature branch first.\"}'; fi"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c '\nimport json, re, sys\ncmd = json.load(sys.stdin).get(\"tool_input\", {}).get(\"command\", \"\")\nflag = \"--delete\" + \"-branch\"\npat = re.compile(r\"(?<!\\S)(\" + re.escape(flag) + r\"|-d)(?!\\S)\")\nfor seg in re.split(r\"[;&|\\n]+\", cmd):\n    if \"gh pr merge\" in seg and pat.search(seg):\n        sys.stderr.write(\"BLOCKED: deleting the branch inside gh pr merge has already closed a PR unmerged. Merge first, verify with: gh pr view <n> --json state,mergedAt \u2014 then delete the branch as a separate step.\\n\")\n        sys.exit(2)\nsys.exit(0)\n' ",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/caveman-activate.js\"",
            "timeout": 5,
            "statusMessage": "Loading caveman mode..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/caveman-mode-tracker.js\"",
            "timeout": 5,
            "statusMessage": "Tracking caveman mode..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git status --short 2>/dev/null; b=$(git branch --show-current 2>/dev/null); [ -z \"$b\" ] && exit 0; if git rev-parse --verify -q \"origin/$b\" >/dev/null 2>&1; then u=$(git log \"origin/$b..HEAD\" --oneline 2>/dev/null | head -5); [ -n \"$u\" ] && printf '%s\\n^ UNPUSHED COMMITS on %s \u2014 task is NOT DONE\\n' \"$u\" \"$b\"; else echo \"^ branch $b has no remote tracking ref \u2014 nothing was ever pushed\"; fi; exit 0",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/hooks/caveman-statusline.sh\""
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "agents@lx_wnk-marketplace": true,
    "skills@lx_wnk-marketplace": true,
    "gopls-lsp@claude-plugins-official": true,
    "atlassian@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "git",
        "url": "https://github.com/JuliusBrussee/caveman.git"
      }
    },
    "lx_wnk-marketplace": {
      "source": {
        "source": "github",
        "repo": "lx-wnk/claude-marketplace"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "outputStyle": "Explanatory",
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark-ansi",
  "editorMode": "normal",
  "autoCompactEnabled": false,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
