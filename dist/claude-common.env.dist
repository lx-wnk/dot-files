# Shared Claude / tooling secrets — loaded FIRST for every account and every shell.
# init-mac.sh copies this to ~/.config/claude/common.env if it does not exist.
# The copy is private (chmod 600, outside any repo). Fill in the real values there.
#
# Put a variable here only if BOTH accounts use the SAME value.
# If personal and work need the same variable name with DIFFERENT values, remove it
# here and set it in claude-personal.env / claude-work.env instead — the account file
# is sourced after this one and wins.
#
# This .dist template is safe to commit — it must never contain real secrets.

export OBSIDIAN_BASE_URL="https://127.0.0.1:27124"
export OBSIDIAN_API_KEY="REPLACE_ME"
export DASHBOARD_MCP_TOKEN="REPLACE_ME"
