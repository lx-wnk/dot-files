# Account-scoped Claude secrets — copied to ~/.config/claude/{personal,work}.env by init-mac.sh.
# Loaded by the claude-personal / claude-work shell wrappers, AFTER common.env, so a variable
# set here overrides the shared value of the same name.
#
# Leave this empty unless personal and work genuinely need different values for the same
# variable. Anything both accounts share belongs in common.env.
#
# Example:
# export OBSIDIAN_API_KEY="REPLACE_ME"
